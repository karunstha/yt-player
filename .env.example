# Copy to .env and adjust for your host. Docker Compose reads .env automatically,
# and so does `yt-player serve` when started from this directory.

# --- Audio output -----------------------------------------------------------

# Sound system used for playback: pulseaudio, pipewire, alsa, jack, coreaudio.
# Empty means automatic outside Docker; Docker Compose defaults to pulseaudio.
# On PipeWire systems, pulseaudio (via pipewire-pulse) supports AUDIO_DEVICE.
AUDIO_DRIVER=

# Output device. Empty uses the system default.
#   PulseAudio/PipeWire: a sink name from `pactl list short sinks`,
#                        e.g. alsa_output.usb-DAC-00.analog-stereo
#                        or bluez_output.AA_BB_CC_DD_EE_FF.1
#   ALSA:                a device from `aplay -l`, e.g. plughw:1,0
AUDIO_DEVICE=

# Full path to ffplay if it is not on the PATH (e.g. /opt/homebrew/bin/ffplay
# when running as a launchd/systemd service). Not needed with Docker.
FFPLAY_PATH=

# Optional Bluetooth speaker MAC address to connect before playback,
# e.g. AA:BB:CC:DD:EE:FF. Combine it with AUDIO_DEVICE to route audio to it.
DEFAULT_BLUETOOTH_DEVICE_ID=

DEFAULT_VOLUME=0.8

# PulseAudio runtime directory on the host. Usually /run/user/<your UID>/pulse;
# check your UID with `id -u`.
PULSE_RUNTIME_DIR=/run/user/1000/pulse

# --- YouTube ----------------------------------------------------------------

# What searches look for when a request doesn't say: songs (YouTube Music),
# music_videos, podcasts (podcast episodes), or videos (anything on YouTube).
DEFAULT_SEARCH_TYPE=songs

# JavaScript runtime for YouTube's challenge: deno, node, bun or quickjs,
# optionally with a path (node:/usr/local/bin/node). Only applies when running
# without Docker; the Docker image ships Deno.
JS_RUNTIME=deno

# --- Service ----------------------------------------------------------------

# Host directory for the database and optional cookies.txt.
DATA_PATH=./data

# Playback service bind address. 0.0.0.0 lets other devices on your network
# reach the API; use 127.0.0.1 to allow only this machine.
SERVICE_HOST=0.0.0.0
SERVICE_PORT=5454

# MCP server (only with `docker compose --profile mcp up -d`)
MCP_HOST=127.0.0.1
MCP_PORT=5455
